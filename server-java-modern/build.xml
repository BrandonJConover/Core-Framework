<project default="compile_core" basedir=".">
    <property name="src" location="src"/>
    <property name="build" location="build"/>
    <property name="lib" location="lib"/>
    <property name="jar" location="core.jar"/>
    <property name="javac.source" value="21"/>
    <property name="javac.target" value="21"/>

    <target name="clean">
        <delete dir="${build}" />
        <delete file="${jar}" />
    </target>

    <target name="compile_plugins">
        <delete file="plugins.jar"/>
        <delete dir="buildplugins"/>
        <mkdir dir="buildplugins"/>
        <javac srcdir="plugins" destdir="buildplugins" debug="on" includeantruntime="false" encoding="UTF-8">
            <classpath>
                <pathelement location="core.jar"/>
                <pathelement path="${java.class.path}/"/>
                <fileset dir="${lib}" includes="*.jar"/>
            </classpath>
            <compilerarg line="--release 21"/>
            <compilerarg line="-Xlint:deprecation"/>
        </javac>
        <jar basedir="buildplugins" destfile="plugins.jar"/>
        <delete dir="buildplugins"/>
    </target>

    <target name="compile_core">
        <delete file="${jar}"/>
        <delete dir="${build}"/>
        <mkdir dir="${build}"/>
        <javac srcdir="${src}" destdir="${build}" debug="on" includeantruntime="false" encoding="UTF-8">
            <classpath>
                <fileset dir="${lib}" includes="*.jar"/>
            </classpath>
            <compilerarg line="--release 21"/>
            <compilerarg line="-Xlint:deprecation"/>
        </javac>
        <jar basedir="${build}" destfile="${jar}"/>
        <delete dir="${build}"/>
    </target>

    <property name="confFile" value="local"/>
    <property name="coloredLogging" value="true"/>

    <target name="runserverzgc">
        <echo message="Using Java 21+ ZGC launch arguments (generational ZGC is default from Java 24)"/>
        <java classname="com.openrsc.server.Server" fork="true">
            <arg value="${confFile}.conf"/>
            <jvmarg line="-Xms800M -Xmx2048M -XX:+UseZGC --enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow -DcoloredLogging=${coloredLogging}"/>
            <classpath>
                <pathelement location="${jar}"/>
                <pathelement location="plugins.jar"/>
                <fileset dir="${lib}" includes="*.jar"/>
            </classpath>
        </java>
    </target>

    <target name="runserver">
        <echo message="Using Java 21 G1GC launch arguments"/>
        <java classname="com.openrsc.server.Server" fork="true">
            <arg value="${confFile}.conf"/>
            <jvmarg line="-Xms800M -Xmx2048M -XX:+UseG1GC -XX:MaxGCPauseMillis=100 --enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow -DcoloredLogging=${coloredLogging}"/>
            <classpath>
                <pathelement location="${jar}"/>
                <pathelement location="plugins.jar"/>
                <fileset dir="${lib}" includes="*.jar"/>
            </classpath>
        </java>
    </target>

    <target name="compile">
        <antcall target="compile_core"/>
        <antcall target="compile_plugins"/>
    </target>

    <target name="compile-and-run">
        <antcall target="compile"/>
        <antcall target="runserver"/>
    </target>
</project>
