.java-version
!.gitignore

# Build outputs
bin/
build/
buildplugins/
core.jar
plugins.jar

# Runtime outputs
logs/*.log
logs/*.log.gz
logs/pcaps/*.pcap
logs/pcaps/*.pcap.gz

# Generated avatars (except .gitsave marker)
avatars/*
!avatars/.gitsave

# Stray files
/failureaccess-*.jar

# Persisted JWT signing secret — generated by JwtUtil at first boot. Must
# never be committed (a leaked secret lets anyone forge tokens for any user).
.jwt-secret

# IDE
.idea/
*.iml.backup
