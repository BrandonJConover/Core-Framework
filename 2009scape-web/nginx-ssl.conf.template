# Production nginx config with SSL for Hetzner VPS deployment.
# Replace ${DOMAIN} before use:
#   envsubst '${DOMAIN}' < nginx-ssl.conf.template > /etc/nginx/sites-available/2009scape-web

server {
    listen 80;
    server_name ${DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Required for WebAssembly
    add_header Cross-Origin-Opener-Policy   "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;

    # Web client static files
    root /opt/2009scape-web/client/dist;
    index index.html;

    location ~* \.wasm$ {
        default_type application/wasm;
        add_header Cross-Origin-Opener-Policy   "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
    }

    # WebSocket proxy — browsers connect to wss://domain/ws
    # which forwards to the websockify container on port 43595
    location /ws {
        proxy_pass http://127.0.0.1:43595;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
