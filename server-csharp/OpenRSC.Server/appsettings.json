{
  "Server": {
    "ServerName": "OpenRSC",
    "WelcomeText": "Welcome to OpenRSC!",
    "GameTickMs": 640,
    "WalkingTickMs": 640,
    "MaxPlayers": 2000,
    "ServerPort": 43594,
    "WebSocketPort": 43494,
    "EnableWebSockets": true,
    "IdleTimeoutMs": 300000,
    "AutoSaveIntervalMs": 30000,
    "MembersWorld": true,
    "WorldNumber": 1,
    "Debug": false,
    "EnableTls": false,
    "TlsCertificatePath": "",
    "TlsCertificatePassword": "",
    "EnableCompression": true,
    "CompressionThreshold": 128,
    "EnableRateLimiting": true,
    "RateLimitPacketsPerSecond": 100
  },
  "Combat": {
    "CombatExpRate": 1.0,
    "WildernessBoost": 0.0,
    "SkullBoost": 0.0,
    "PidlessCatching": false,
    "PvmCatchingDistance": 1,
    "PvpCatchingDistance": 1,
    "SpellRangeDistance": 4
  },
  "ActionRetry": {
    "Enabled": true,
    "MaxRetries": 10
  },
  "Database": {
    "Provider": "MySQL",
    "ConnectionString": "Server=localhost;Database=openrsc;User=root;Password=;",
    "TablePrefix": "",
    "MinPoolSize": 5,
    "MaxPoolSize": 100,
    "CommandTimeoutSeconds": 30,
    "EnableQueryLogging": false
  },
  "Security": {
    "MasterEncryptionKey": "",
    "EncryptSensitiveData": true,
    "PasswordHashAlgorithm": "Argon2id",
    "EnforceStrongPasswords": true,
    "MinPasswordLength": 8,
    "MaxFailedLoginAttempts": 5,
    "AccountLockoutMinutes": 15,
    "EnableSecurityAuditLog": true
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "Password": null,
    "Database": 0,
    "KeyPrefix": "openrsc:",
    "DefaultExpirationSeconds": 300,
    "SessionExpirationSeconds": 86400
  },
  "DDoSProtection": {
    "Enabled": true,
    "MaxConnectionsPerIp": 10,
    "ConnectionWindowSeconds": 60,
    "MaxRequestsPerSecond": 100,
    "MaxBytesPerSecond": 102400,
    "MaxFailedAuthAttempts": 5,
    "AuthBanDurationMinutes": 15
  },
  "Serialization": {
    "DefaultFormat": "MessagePack",
    "UseMemoryPackForInternal": true,
    "UseMessagePackForClients": true,
    "EnableMessagePackCompression": true,
    "CompressionThreshold": 256
  },
  "HttpServer": {
    "Enabled": true,
    "HttpPort": 8080,
    "HttpsPort": 8443,
    "EnableHttps": false,
    "EnableHttp2": true,
    "EnableHttp3": true,
    "CertificatePath": "",
    "CertificatePassword": "",
    "MaxRequestBodySize": 10485760,
    "CorsOrigins": "*",
    "EnableSwagger": true,
    "AdminApiKey": "",
    "EnableRateLimiting": true,
    "RateLimitPerMinute": 100
  },
  "QuicTransport": {
    "Enabled": false,
    "Port": 43595,
    "CertificatePath": "",
    "CertificatePassword": "",
    "MaxBidirectionalStreams": 100,
    "MaxUnidirectionalStreams": 100,
    "IdleTimeoutSeconds": 60,
    "AlpnProtocol": "openrsc-v1"
  },
  "Logging": {
    "ConsoleMinimumLevel": "Information",
    "FileMinimumLevel": "Debug",
    "EnableAsync": true,
    "LogFilePath": "logs/server-.log",
    "RetainedFileCountLimit": 31,
    "FileSizeLimitBytes": 104857600,
    "EnableJsonLogs": true,
    "JsonLogFilePath": "logs/server-.json",
    "EnableSeq": false,
    "SeqServerUrl": "http://localhost:5341",
    "SeqApiKey": "",
    "EnableLoki": false,
    "LokiUrl": "http://localhost:3100",
    "ApplicationName": "OpenRSC.Server",
    "EnvironmentName": "Development"
  },
  "ServiceDiscovery": {
    "Enabled": false,
    "Provider": "None",
    "ServiceName": "openrsc-server",
    "InstanceId": "",
    "Address": "",
    "HealthCheckEndpoint": "/health",
    "HealthCheckIntervalSeconds": 10,
    "Tags": ["game", "openrsc"]
  },
  "Consul": {
    "Enabled": false,
    "Address": "http://localhost:8500",
    "Datacenter": "dc1",
    "Token": null,
    "WaitTimeSeconds": 300,
    "KeyPrefix": "openrsc/"
  },
  "Etcd": {
    "Enabled": false,
    "Endpoints": "http://localhost:2379",
    "Username": null,
    "Password": null,
    "ServicePrefix": "/openrsc/services/",
    "ConfigPrefix": "/openrsc/config/",
    "LeaseTtlSeconds": 30
  },
  "AzureAppConfiguration": {
    "Enabled": false,
    "Endpoint": "",
    "ConnectionString": null,
    "UseManagedIdentity": true,
    "Label": "",
    "KeyPrefix": "OpenRSC:",
    "EnableRefresh": true,
    "SentinelKey": "OpenRSC:Sentinel",
    "CacheExpirationSeconds": 30,
    "EnableFeatureFlags": true,
    "EnableKeyVaultReferences": true
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "openrsc-server",
    "ServiceVersion": "1.0.0",
    "Environment": "development",
    "EnableTracing": true,
    "EnableMetrics": true,
    "EnableConsoleExporter": false,
    "EnableOtlpExporter": true,
    "OtlpEndpoint": "http://localhost:4317",
    "OtlpProtocol": "grpc",
    "TraceSamplingRatio": 1.0,
    "InstrumentAspNetCore": true,
    "InstrumentHttpClient": true,
    "EnableRuntimeMetrics": true,
    "MetricsExportIntervalSeconds": 15
  },
  "Prometheus": {
    "Enabled": true,
    "Endpoint": "/metrics",
    "ScrapeResponseCacheDurationMilliseconds": 300,
    "IncludeRuntimeMetrics": true,
    "IncludeAspNetCoreMetrics": true,
    "IncludeHttpClientMetrics": true,
    "UseOpenMetricsFormat": true
  },
  "ApplicationInsights": {
    "Enabled": false,
    "ConnectionString": "",
    "CloudRoleName": "openrsc-server",
    "CloudRoleInstance": null,
    "EnableLiveMetrics": true,
    "EnableAdaptiveSampling": true,
    "SamplingPercentage": 100,
    "EnableDependencyTracking": true,
    "EnableRequestTracking": true,
    "EnableExceptionTracking": true
  },
  "OAuth": {
    "Enabled": false,
    "EnableGoogle": false,
    "GoogleClientId": "",
    "GoogleClientSecret": "",
    "EnableApple": false,
    "EnableDiscord": false,
    "CallbackUrlBase": "",
    "AllowAccountLinking": true
  },
  "AuthToken": {
    "EnableRefreshTokens": true,
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 30,
    "MaxRefreshTokensPerUser": 5,
    "RotateRefreshTokens": true,
    "RevokeTokensOnPasswordChange": true
  },
  "Device": {
    "Enabled": true,
    "MaxDevicesPerUser": 10,
    "NewDeviceRiskScore": 25,
    "VerificationThreshold": 50,
    "AutoRegisterDevices": true,
    "BlockCompromisedDevices": false,
    "BlockEmulators": false,
    "NotifyNewDevice": true,
    "DeviceRetentionDays": 365
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  }
}
